{
  "name": "hanpit",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "type": "module",
  "description": "Local-first Chinese study with HSK flashcards, grammar, readings and tests.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "data:import": "node scripts/import-vocabulary.mjs",
    "audio:generate": ".venv-audio/bin/python scripts/generate-audio.py",
    "audio:check": ".venv-audio/bin/python scripts/generate-audio.py --validate",
    "audio:test": ".venv-audio/bin/python scripts/test_audio.py",
    "grammar:check": "python3 scripts/check-grammar.py",
    "grammar:audio": ".venv-audio/bin/python scripts/generate-grammar-audio.py",
    "grammar:audio:check": ".venv-audio/bin/python scripts/generate-grammar-audio.py --validate",
    "grammar:audio:test": ".venv-audio/bin/python scripts/test_grammar_audio.py",
    "curriculum:build": "python3 scripts/curriculum.py --build",
    "curriculum:check": "python3 scripts/curriculum.py --check",
    "curriculum:test": "python3 scripts/test_curriculum.py",
    "tests:check": "python3 scripts/check-tests.py"
  },
  "overrides": {
    "xcode": { "uuid": "11.1.1" }
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
